# Copy to .env for local runs. Do not put real secrets in this file.
APP_ENV=development
LOG_LEVEL=info

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s

# Optional full connection URL. When set, it replaces DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME, and DB_SSLMODE.
# DATABASE_URL=postgres://todo:todo@localhost:5432/todo?sslmode=disable

DB_HOST=localhost
DB_PORT=5432
DB_USER=todo
DB_PASSWORD=todo
DB_NAME=todo
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s

# Comma-separated browser origins, or * . Leave empty to disable CORS.
ALLOWED_ORIGINS=

# Comma-separated proxy IPs or CIDRs. Leave empty to ignore forwarded headers.
TRUSTED_PROXIES=

# Set RATE_LIMIT_RPS to 0 to disable limiting.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

MIGRATIONS_PATH=migrations
